# Enforce Unix newlines
*.css   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.php   text eol=lf
*.rb    text eol=lf
*.scss  text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf

# Generated build output. Hidden in pull request diffs and excluded from the
# language statistics — rebuild it with `npm run build`, never edit by hand.
dist/** -diff linguist-generated=true
